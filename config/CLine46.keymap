#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB     &kp Q    &kp W     &kp E     &kp R               &kp T                                           &kp Y             &kp U  &kp I      &kp O       &kp P      &kp BACKSPACE
&kp LCTRL   &kp A    &kp S     &kp D     &kp F               &kp G                                           &kp H             &kp J  &kp K      &kp L       &kp MINUS  &kp RETURN
&kp LSHIFT  &kp Z    &kp X     &kp C     &kp V               &kp B                                           &kp N             &kp M  &kp COMMA  &kp DOT     &mo 3      &kp RSHIFT
            &kp ESC  &kp LGUI  &kp LALT  &lt 2 INT_MUHENKAN  &lt 5 SPACE  &lt 1 LANGUAGE_2    &kp BACKSPACE  &lt 4 LANGUAGE_1                    &kp DELETE  &kp TAB
            >;
        };

        layer_1 {
            bindings = <
&kp CARET  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                    &kp LCTRL          &kp AMPERSAND   &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&kp MINUS  &kp PLUS         &trans       &trans    &kp EQUAL   &kp PLUS                       &kp SQT            &kp MINUS       &kp SEMICOLON  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PIPE
&kp SLASH  &kp ASTERISK     &trans       &trans    &kp GRAVE   &kp MINUS                      &kp DOUBLE_QUOTES  &kp UNDERSCORE  &kp COLON      &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp PERCENT
           &trans           &trans       &trans    &trans      &trans       &trans    &trans  &trans                                            &kp PIPE              &kp TILDE
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F10                     &kp KP_EQUAL    &kp N7        &kp N8        &kp N9        &kp KP_SLASH     &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11                     &kp MINUS       &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp KP_MULTIPLY  &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F12                     &kp UNDERSCORE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_MINUS     &trans
        &trans  &trans  &trans  &trans  &trans   &trans    &kp RET  &kp N0                                      &kp PERIOD    &kp KP_PLUS
            >;
        };

        SCROLL {
            bindings = <
&bt BT_CLR      &trans  &trans        &trans        &trans        &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans  &bt BT_SEL 4  &trans        &trans        &trans                            &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans                            &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &bt BT_SEL 0  &trans        &trans        &trans  &trans    &studio_unlock  &trans                  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                    &kp F6     &kp F7     &kp F8     &kp F9       &kp F10     &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans                    &kp LC(Z)  &kp LC(C)  &kp LC(V)  &kp LA(TAB)  &kp LA(F4)  &trans
&trans  &trans   &trans   &trans  &trans  &trans                    &kp LC(Y)  &trans     &trans     &trans       &kp DELETE  &trans
        &trans   &trans   &trans  &trans  &trans  &trans    &trans  &trans                           &trans       &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &trans                    &kp LG(LEFT_ARROW)  &kp PAGE_UP     &kp UP_ARROW    &kp PAGE_DOWN    &kp LG(RIGHT_ARROW)  &trans
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans                    &kp LC(Z)           &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp ENTER            &trans
&trans  &trans  &kp HOME        &mkp MB2        &kp END          &trans                    &kp LC(Y)           &kp HOME        &mkp MB2        &kp END          &trans               &trans
        &trans  &trans          &trans          &trans           &trans  &trans    &trans  &trans                                              &trans           &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                    &trans  &trans
            >;
        };
    };
};
